# ==============================================================================
# CogniStudy Pro™ — Environment Configuration Template
# ==============================================================================

# Application Settings
APP_NAME="CogniStudy Pro"
APP_VERSION="3.0.0"
ENVIRONMENT="production"
DEBUG=false

# Server Networking
HOST="0.0.0.0"
PORT=8000

# Security (Optional API Key Protection for REST endpoints)
# If left empty, API endpoints are open for public/demo use.
API_KEY=""
CORS_ORIGINS=["*"]

# LLM Providers Configuration
# Supported providers: openai, groq, anthropic, ollama, mock
DEFAULT_LLM_PROVIDER="openai"
DEFAULT_MODEL_NAME="gpt-4o-mini"
LLM_TEMPERATURE=0.2
MAX_TOKENS=1500

# Provider API Keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# Embeddings Configuration
# Options: openai (production), mock (offline/zero-cost demo)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"

# Vector Store & Storage Settings
INDEX_STORAGE_DIR="faiss_data"
DEFAULT_INDEX_DIR="."
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_SEARCH_K=4

# 24/7 Telegram Assistant Integration
# 1. Obtain your Bot token from @BotFather on Telegram
# 2. Paste the token below:
TELEGRAM_BOT_TOKEN=""
# 3. Webhook URL (Public HTTPS endpoint where this service is hosted):
TELEGRAM_WEBHOOK_URL="https://your-domain.com/telegram-webhook"
